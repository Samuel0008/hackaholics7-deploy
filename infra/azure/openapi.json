{
  "openapi": "3.0.1",
  "info": {
    "title": "Banking Attestation API",
    "version": "1.0"
  },
  "paths": {
    "/health": { "get": { "operationId": "health", "responses": { "200": { "description": "Health status" } } } },
    "/robots.txt": { "get": { "operationId": "robots", "responses": { "200": { "description": "Crawler metadata" } } } },
    "/.env": { "get": { "operationId": "decoyEnvironment", "responses": { "200": { "description": "Synthetic decoy" } } } },
    "/debug/config": { "get": { "operationId": "decoyDebugConfig", "responses": { "200": { "description": "Synthetic decoy" } } } },
    "/backup/database.sql": { "get": { "operationId": "decoyDatabaseBackup", "responses": { "200": { "description": "Synthetic decoy" } } } },
    "/internal/employee/access-review-export.json": { "get": { "operationId": "decoyAccessReview", "responses": { "200": { "description": "Synthetic decoy" } } } },
    "/internal/employee/audit-export/{tenantId}/{token}": { "get": { "operationId": "canaryAccess", "parameters": [{ "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "token", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "404": { "description": "Not found" } } } },
    "/passkeys/register/options": { "post": { "operationId": "registrationOptions", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "description": "Registration challenge" } } } },
    "/passkeys/register/verify": { "post": { "operationId": "registrationVerify", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "description": "Registration result" } } } },
    "/passkeys/auth/options": { "post": { "operationId": "authenticationOptions", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "description": "Authentication challenge" } } } },
    "/passkeys/auth/verify": { "post": { "operationId": "authenticationVerify", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "description": "Short-lived session token and authenticated tenant-scoped employee identifiers" } } } },
    "/sync/{documentId}": {
      "put": { "operationId": "storeEncryptedDocument", "parameters": [{ "name": "documentId", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "description": "Stored" } } },
      "get": { "operationId": "getEncryptedDocument", "parameters": [{ "name": "documentId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Encrypted document" } } }
    },
    "/keys/message": { "post": { "operationId": "registerMessageKey", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "description": "Key registered" } } } },
    "/keys/message/{userId}": { "get": { "operationId": "getMessageKeys", "parameters": [{ "name": "userId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Public recipient keys" } } } },
    "/security/canaries": { "post": { "operationId": "createCanary", "responses": { "201": { "description": "Canary created" } } } },
    "/security/alerts": { "get": { "operationId": "listCanaryAlerts", "responses": { "200": { "description": "Tenant-scoped canary alerts, first-hit reauthentication actions, account suspensions, and investigation audit records" } } } },
    "/security/dashboard/telemetry": { "get": { "operationId": "securityDashboardTelemetry", "description": "Returns tenant-scoped decoy alert history and counts only. It does not provide IP attribution, network fingerprinting, general threat detection, or network quarantine.", "responses": { "200": { "description": "Tenant decoy alerts with explicit capability limitations" }, "403": { "description": "Missing Bank.SecurityAdmin role" } } } },
    "/security/crypto/registry": { "get": { "operationId": "cryptoRegistry", "description": "Returns configured Azure Key Vault escrow-encryption and audit-signing public key metadata. It does not attest client hardware or report rotation history, key access counts, or immutable retention.", "responses": { "200": { "description": "Configured tenant public key metadata" }, "403": { "description": "Missing Bank.SecurityAdmin role" } } } },
    "/security/audit/public-key": { "get": { "operationId": "getAuditSigningPublicKey", "description": "Return the tenant's RSA public key for independently verifying signed incident and containment evidence. Specify version to retrieve an earlier key version.", "parameters": [{ "name": "version", "in": "query", "required": false, "schema": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,64}$" } }], "responses": { "200": { "description": "Tenant audit signing public key and versioned key ID" }, "400": { "description": "Invalid key version" } } } },
    "/security/quarantine/release": { "post": { "operationId": "releaseQuarantine", "description": "Release a suspended account after investigation. Requires a tenant-scoped userId, investigationReference, and investigationSummary.", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "description": "Account released and investigation recorded" }, "400": { "description": "Required investigation details are invalid" }, "404": { "description": "Suspended account not found or already released" } } } },
    "/escrow/public-key": { "get": { "operationId": "getEscrowPublicKey", "responses": { "200": { "description": "Tenant escrow public key" } } } },
    "/security/compliance/decrypt": { "post": { "operationId": "complianceDecrypt", "description": "Decrypts a tenant envelope for a user with Bank.Compliance and requires a caseReference and reason. Records verified actor and caller IDs in the tenant-signed audit alert.", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "description": "Decrypted compliance payload, returned only after audit recording" }, "400": { "description": "Required case reference or reason is invalid" }, "403": { "description": "Missing Bank.Compliance role" } } } },
    "/security/compliance/audit": { "get": { "operationId": "complianceAudit", "responses": { "200": { "description": "Escrow access audit" } } } },
    "/security/devices/revoke": { "post": { "operationId": "revokeDevice", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "description": "Device and associated passkeys revoked for API access; no physical device command is sent" } } } },
    "/security/devices/compliance/demo": {
      "get": { "operationId": "getDemoDeviceCompliance", "description": "Get admin-entered demo compliance status. Values are never authoritative device posture.", "parameters": [{ "name": "userId", "in": "query", "required": true, "schema": { "type": "string" } }, { "name": "deviceId", "in": "query", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Non-authoritative demo compliance status" }, "400": { "description": "Invalid query parameters" }, "404": { "description": "Enrolled device not found" } } },
      "post": { "operationId": "recordDemoDeviceCompliance", "description": "Record administrator-entered, non-authoritative demo compliance status; no MDM attestation is performed.", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "description": "Demo compliance status recorded" }, "400": { "description": "Invalid demo status or note" }, "404": { "description": "Enrolled device not found" } } }
    },
    "/security/devices/actions": { "get": { "operationId": "listDemoDeviceActions", "description": "List up to 100 tenant-scoped simulated lock/wipe requests. No device commands are sent.", "responses": { "200": { "description": "Simulation-only device action records" } } } },
    "/security/devices/actions/request": { "post": { "operationId": "requestDemoDeviceAction", "description": "Create a pending, approval-gated simulation-only lock/wipe request. No MDM integration or device command exists.", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "201": { "description": "Pending approval; no device command sent" }, "400": { "description": "Invalid request" }, "404": { "description": "Enrolled device not found" }, "409": { "description": "Device is not active" } } } },
    "/security/devices/actions/decide": { "post": { "operationId": "decideDemoDeviceAction", "description": "Approve or reject a pending simulation-only request. A different security administrator must decide. Approval never issues a device command.", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "description": "Decision recorded; no device command sent" }, "400": { "description": "Invalid decision" }, "403": { "description": "Requester cannot decide their own request" }, "404": { "description": "Request not found" }, "409": { "description": "Request already decided or concurrently modified" } } } }
  },
  "components": {
    "requestBodies": {
      "JsonObject": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "type": "object", "additionalProperties": true }
          }
        }
      }
    }
  }
}
